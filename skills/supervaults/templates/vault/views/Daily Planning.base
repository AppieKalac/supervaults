views:
  - type: table
    name: "Open daily plans"
    filters:
      and:
        - 'type == "daily-plan"'
        - 'status == "open"'
    order:
      - file.name
      - date
      - status
  - type: table
    name: "Selected workstreams"
    filters:
      and:
        - 'type == "workstream"'
        - 'status == "active"'
    order:
      - file.name
      - stage
      - status
